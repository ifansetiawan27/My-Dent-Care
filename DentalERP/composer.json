{
    "name": "dentalerp/platform",
    "type": "project",
    "description": "Dental ERP — Enterprise Platform for Multi-Branch Dental Clinic Management",
    "require": {
        "php": "^8.4",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "ext-zip": "*",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "midtrans/midtrans-php": "^2.6",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "*",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "process-timeout": 900,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
