# Staging environment template.
#
# Copy to .env.staging and fill in real values from the secret manager.
# .env.staging is git-ignored and must never be committed.

APP_NAME=DentalERP
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com
APP_PORT=8080

APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dentalerp_staging
DB_USERNAME=dentalerp
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer

# Cache / Session / Queue
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=staging.example.com

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Filesystem (S3-compatible object storage)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=dentalerp-staging
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Sanctum / Auth
SANCTUM_STATEFUL_DOMAINS=staging.example.com
SANCTUM_ACCESS_TOKEN_TTL=60

# Audit / Notification queues
AUDIT_QUEUE=audit
AUDIT_QUEUE_CONNECTION=redis
AUDIT_RETENTION_DAYS=365
NOTIFICATION_QUEUE=notifications
NOTIFICATION_QUEUE_CONNECTION=redis
NOTIFICATION_RETRY_ATTEMPTS=3

# Payment Gateway (Midtrans) — sandbox credentials only in staging
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Security headers — HSTS requires TLS termination in front of the app
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
