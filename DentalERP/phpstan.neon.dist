includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 2

    paths:
        - app

    excludePaths:
        analyseAndScan:
            - app/*/Migrations/*

    # Inline @phpstan-ignore annotations predate this configuration, so several
    # no longer match anything. They are harmless; do not fail the build on them.
    reportUnmatchedIgnoredErrors: false
