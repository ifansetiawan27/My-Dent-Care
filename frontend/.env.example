# Local development
# Leave unset to use the Vite dev-server proxy (see vite.config.ts -> port 8080),
# or point directly at a running backend.
VITE_API_BASE_URL=http://localhost:8080/api

# Production (set this in Vercel/Netlify dashboard)
# Must be HTTPS — a plain-HTTP URL is blocked as mixed content on an HTTPS site.
# VITE_API_BASE_URL=https://api.mydentcare.com/api